{
  "name": "payment-service",
  "version": "1.0.0",
  "private": true,
  "description": "Payment routing API with fraud scoring",
  "main": "src/server.js",
  "files": ["src"],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "lint": "eslint .",
    "test:unit": "mkdir -p reports && node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=reports/unit.xml test/unit/*.test.js",
    "test:integration": "mkdir -p reports && node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=reports/integration.xml test/integration/*.test.js",
    "test:fraud": "mkdir -p reports && node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=reports/fraud.xml test/fraud/*.test.js",
    "test": "npm run test:unit && npm run test:integration && npm run test:fraud",
    "audit": "npm audit --omit=dev --audit-level=high",
    "package": "mkdir -p dist && npm pack --pack-destination dist",
    "smoke": "node scripts/smoke.js"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0"
  }
}
